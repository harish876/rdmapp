# Maximum Transmission Unit (packet size in bytes)
mtu=1024

# Number of packets per chunk
chunk_size=16

# Buffer size in bytes
#buffer_size= 2147483648 #2GiB
buffer_size= 1073741824 #1GiB
#buffer_size= 524288000  #500MiB
#buffer_size= 104857600  #100MiB
#buffer_size= 10485760   #10MiB
#buffer_size= 1048576    #1MiB

#buffer_size= 2097152 #4194304
# CPU core ID for thread pinning (-1 means no pinning)
cpu_core_id=2

# Receiver timeout in seconds
receiver_timeout_seconds=60

# Transport Type (UC / RC)
transport_type = "uc"

# Logging
enable_logging = "false"

enable_selective_repeat = "true"

sr_rto_ms = 93

packet_loss_probability= 0.1
