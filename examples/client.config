# Buffer size in bytes. Only used by the sender
# buffer_size=2147483648
# buffer_size=1073741824
# buffer_size=524288000
# buffer_size=104857600
# buffer_size=10485760
buffer_size=1048576

# Batching
num_concurrent_chunks=1
enable_batched_sends = "false"

# Maximum Transmission Unit (packet size in bytes)
mtu=1024

# Number of packets per chunk
chunk_size=16

# RX Depth - Completion Queue depth
rx_depth=8192

# Transport Type (UC / RC)
transport_type = "uc"

# Logging
enable_logging = "true"
logging_level = "debug"